# Local configuration: contains deployment paths and push endpoints.
config.yaml

# Encrypted secrets, key material and session snapshots.
secrets/
.local/
*.enc
*.key
*.state.json

# Data, caches and logs.
data/
inbox/*.md
!inbox/.gitkeep
*.sqlite3
*.sqlite3-*
*.log

# Python.
__pycache__/
*.pyc
.venv/
venv/
.test-output/
.pytest_cache/
.coverage
htmlcov/

# Local evaluation evidence may contain private notices.
docs/*.json

# Manual portal bundles and the client config contain private notices/paths.
portal_client.yaml
portal-*.json
portal-*.json.gz
portal-out/
